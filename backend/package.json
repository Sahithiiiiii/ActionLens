{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "worker": "tsx watch src/workers/document.worker.ts",
    "reminder-worker": "tsx watch src/workers/reminder.worker.ts",
    "email-worker": "tsx watch src/workers/email.worker.ts",
    "dev:all": "concurrently -n api,docs,remind,email -c blue,green,yellow,magenta \"npm:dev\" \"npm:worker\" \"npm:reminder-worker\" \"npm:email-worker\"",
    "test": "node --import tsx --test src/lib/timezone.test.ts src/config/redis-connection.test.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pm2": "^7.1.2",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
