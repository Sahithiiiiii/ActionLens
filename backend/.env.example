PORT=5000
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_URL=postgresql://postgres:password@localhost:5432/actionlens

# Auth: use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

GEMINI_API_KEY=
GEMINI_MODEL=
# Email (SMTP). Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=
EMAIL_FROM=ActionLens <your.address@gmail.com>
TEST_EMAIL=

# Link in reminder emails (your frontend URL)
APP_URL=http://localhost:5173
# Set to 1 when the API runs behind a proxy (nginx, Render, ...) so rate limits use real client IPs
TRUST_PROXY=0
